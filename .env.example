# Copy this file to .env and fill in the values. Never commit .env.

# --- Postgres (local Docker) ---
POSTGRES_DB=kb_auditor
POSTGRES_USER=kb_auditor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The auditor reads the company knowledge base through this connection.
# In a real company this would be a separate, read-only connection to their vector store.
# Locally it is the same database. Leave empty to build it from the POSTGRES_* values above.
KB_DATABASE_URL=

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true

# --- Login (JWT) ---
# Access token: sent with every API call. Refresh token: gets a new access token (also how long you stay logged in).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8
# This many wrong passwords in a row lock the account for LOGIN_LOCK_MINUTES (an admin can unlock earlier).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# --- AWS / Bedrock ---
AWS_REGION=ap-south-1
# AWS credentials. Required when running in Docker. Use an IAM user that may ONLY call Bedrock
# (bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream), not admin keys. Never commit this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
AWS_SESSION_TOKEN=

# Fill these after listing the models available in Mumbai (see README, step 3).
# Some models must be called through an inference profile ID (for example one starting with "apac.").
CHAT_MODEL_ID=
EMBED_MODEL_ID=
# Must match the embedding model's output size. Titan Text Embeddings V2 supports 256/512/1024.
# Changing it after the first migration requires recreating the KB tables.
EMBED_DIM=1024

# Optional. Leave empty to not send temperature (some newer models reject it).
CHAT_TEMPERATURE=

# Prices in USD per 1,000 tokens, from the AWS Bedrock pricing page. Used only for cost tracking.
CHAT_PRICE_INPUT_PER_1K=0
CHAT_PRICE_OUTPUT_PER_1K=0

# --- Auditor tuning ---
CANDIDATE_TOP_K=5
CANDIDATE_MIN_SIMILARITY=0.5
MAX_PAIRS_PER_RUN=300
INVESTIGATOR_MAX_STEPS=4

# --- Chat ---
# Passages given to the model per question, and the minimum similarity to count as relevant.
CHAT_TOP_K=5
CHAT_MIN_SIMILARITY=0.3
# Max questions per user per minute (protects your Bedrock quota).
CHAT_RATE_LIMIT_PER_MIN=20
# The rate-limit counters are kept in Redis. docker-compose sets REDIS_URL itself (redis://redis:6379/0),
# so leave it out of this file. On the laptop without Redis, the in-memory cache is used (fine for one process).

# --- Uploads ---
# Max size of an uploaded document in MB. Above 2, also raise client_max_body_size in frontend/nginx.conf.
UPLOAD_MAX_MB=1

# --- Docker only ---
# Port to open the app on: http://localhost:8080
APP_PORT=8080
# gunicorn: processes x threads = how many requests (incl. streaming chats) run at the same time.
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
